# Hugging Face API token used only by the server route for AI refinement.
# Optional. If missing, the app falls back to deterministic scoring only.
HF_TOKEN=

# Hugging Face model id used by the server route.
# Optional when running in deterministic fallback mode.
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Resend API key used only by the server route for email delivery.
# Optional. If missing, the app returns a graceful email error.
RESEND_API_KEY=

# Sender identity used by Resend.
# Optional. The API route falls back to CareerFit AI <onboarding@resend.dev>.
RESEND_FROM_EMAIL=CareerFit AI <onboarding@resend.dev>
